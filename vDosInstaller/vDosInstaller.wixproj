<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003" ToolsVersion="4.0">
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Debug</Configuration>
    <Platform Condition="'$(Platform)' == ''">Win32</Platform>
    <OutputPath>bin\$(Configuration)</OutputPath>
    <IntermediateOutputPath>obj\$(Configuration)</IntermediateOutputPath>
    <VDosOutputDir>$(MSBuildThisFileDirectory)..\$(Configuration)</VDosOutputDir>
    <MonitorOutputDir>$(MSBuildThisFileDirectory)..\vDosPrintMonitor\publish\win-x86</MonitorOutputDir>
    <ConfigOutputDir>$(MSBuildThisFileDirectory)..\vDosConfig\publish\win-x86</ConfigOutputDir>
    <VDosIconPath>$(MSBuildThisFileDirectory)..\VDosApp\src\vDos2026.ico</VDosIconPath>
    <InstallerOutput>$(MSBuildThisFileDirectory)$(OutputPath)\vDos2026.msi</InstallerOutput>
    <ProjectGuid>{90e0277b-046d-4053-bb1e-51bafb85f4d5}</ProjectGuid>
  </PropertyGroup>
  <ItemGroup>
    <WixSource Include="Package.wxs" />
  </ItemGroup>
  <Target Name="BuildInputs">
    <MSBuild Projects="$(MSBuildThisFileDirectory)..\vDos.vcxproj" Properties="Configuration=$(Configuration);Platform=Win32" Targets="Build" />
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\vDosPrintMonitor\vDosPrintMonitor.csproj&quot; -c $(Configuration) -r win-x86 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:EnableCompressionInSingleFile=true -p:PublishDir=&quot;$(MonitorOutputDir)\&quot;" />
    <Exec Command="dotnet publish &quot;$(MSBuildThisFileDirectory)..\vDosConfig\vDosConfig.csproj&quot; -c $(Configuration) -r win-x86 --self-contained true -p:PublishSingleFile=true -p:IncludeNativeLibrariesForSelfExtract=true -p:EnableCompressionInSingleFile=true -p:PublishDir=&quot;$(ConfigOutputDir)\&quot;" />
  </Target>
  <Target Name="Build" DependsOnTargets="BuildInputs">
    <MakeDir Directories="$(MSBuildThisFileDirectory)$(OutputPath);$(MSBuildThisFileDirectory)$(IntermediateOutputPath)" />
    <Exec Command="wix build &quot;$(MSBuildThisFileDirectory)Package.wxs&quot; -arch x86 -ext WixToolset.UI.wixext -out &quot;$(InstallerOutput)&quot; -intermediateFolder &quot;$(MSBuildThisFileDirectory)$(IntermediateOutputPath)&quot; -d VDosOutputDir=&quot;$(VDosOutputDir)&quot; -d MonitorOutputDir=&quot;$(MonitorOutputDir)&quot; -d ConfigOutputDir=&quot;$(ConfigOutputDir)&quot; -d VDosIconPath=&quot;$(VDosIconPath)&quot;" />
  </Target>
  <Target Name="Clean">
    <RemoveDir Directories="$(MSBuildThisFileDirectory)$(OutputPath);$(MSBuildThisFileDirectory)$(IntermediateOutputPath)" />
  </Target>
  <Target Name="Rebuild" DependsOnTargets="Clean;Build" />
</Project>
